    {
      "parameters": {
        "jsCode": "const r = $json.body ?? {};\nreturn [{ json: {\n  status: r.status,\n  resultado_carga: r.resultado_carga,\n  recursos: (r.bronze ?? []).length,\n  respostas_novas: (r.bronze ?? []).reduce((s, b) => s + (b.respostas_novas ?? 0), 0),\n  etapas: (r.etapas ?? []).map(e => `${e.comando}: saida ${e.codigo_saida} em ${e.duracao_s} s`),\n  duracao_s: r.duracao_s,\n  commit: r.commit,\n  log: r.log,\n} }];\n"
      },
      "id": "9e038d30-dd12-577d-94f0-149bf4448009",
      "name": "Resumo do sucesso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza as tres saidas que nao sao sucesso (radar-etl fora, ocupado, HTTP != 200)\n// para uma linha de bronze.execucao. O status do container nunca e inventado:\n// vem do JSON de resposta do disparador.\nconst j = $json;\nlet status = 'erro';\nlet mensagem;\nif (j.error) {\n  mensagem = `n8n: radar-etl inalcancavel ou sem resposta (${j.error.message ?? j.error})`;\n} else if (j.statusCode === undefined && j.status === 'ocupado') {\n  status = 'ignorada_trava';\n  mensagem = 'n8n: radar-etl ocupado com outro job (/saude); disparo nao feito';\n} else {\n  const corpo = typeof j.body === 'string' ? (() => { try { return JSON.parse(j.body); } catch { return { motivo: j.body }; } })() : (j.body ?? {});\n  if (j.statusCode === 409) status = 'ignorada_trava';\n  mensagem = `n8n: HTTP ${j.statusCode} ${corpo.status ?? ''}: ${corpo.motivo ?? ''}`.trim();\n}\nreturn [{ json: { status, mensagem: mensagem.slice(0, 1000), http: j.statusCode ?? null } }];\n"
      },
      "id": "66ebcf44-2c32-54de-bb43-1ecff689a184",
      "name": "Monta o registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        140
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO bronze.execucao\n       (rodada_id, origem_carga, disparado_por, modo, recurso, finalizado_em, status, mensagem)\nVALUES (gen_random_uuid(), 'python', 'agenda_n8n', 'incremental', 'rodada', now(), $1, $2)\nRETURNING execucao_id, status, mensagem;",
        "options": {
          "queryReplacement": "={{ [ $json.status, $json.mensagem ] }}"
        }
      },
