# ============================================================
# Radar de Expansão — modelo de variáveis de ambiente
# Copie para `.env` (que NUNCA é commitado) e preencha com os seus valores.
#   PowerShell:  Copy-Item .env.example .env
# Supabase e n8n são autohospedados via Docker (detalhes no spec.md, seção 10).
# ============================================================

# --- Banco (Postgres do Supabase) — scripts de ingestão e transformação ---
# No computador do desenvolvedor, o banco chega por um túnel autenticado em localhost:5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=etl_radar
DB_PASSWORD=
# prefer (padrão) | require | disable
DB_SSLMODE=prefer

# --- Dashboard (Streamlit) — leitura da gold pela API REST do Supabase ---
# No Streamlit Cloud estes valores vão em Settings > Secrets (modelo em .streamlit/secrets.toml.example).
SUPABASE_URL=https://<url-da-api>
SUPABASE_ANON_KEY=
SUPABASE_CHAVE_LEITURA=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
