# Radar de Expansao - variaveis do container radar-bairros (copie para .env e faca chmod 600)
# Banco pela rede Docker "radar" (sem TLS dentro da rede interna)
DB_HOST=supabase-db
DB_PORT=5432
DB_NAME=postgres
DB_USER=etl_radar
DB_PASSWORD=
DB_SSLMODE=disable
# Usuario do container = dono das pastas dados/ e logs/ (id -u; id -g)
RADAR_BAIRROS_UID=1000
RADAR_BAIRROS_GID=1000
