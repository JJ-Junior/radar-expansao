# Radar de Expansao - variaveis do container radar-etl (copie para .env e faca chmod 600)
# Banco pela rede Docker "radar" (sem TLS dentro da rede interna)
DB_HOST=supabase-db
DB_PORT=5432
DB_NAME=postgres
DB_USER=etl_radar
DB_PASSWORD=
DB_SSLMODE=disable
# Segredo do header X-Radar-Token (gere com: openssl rand -hex 32).
# No n8n vira uma credencial "Header Auth" (nome X-Radar-Token).
RADAR_ETL_TOKEN=
# Usuario do container = dono da pasta logs/ no host (id -u; id -g)
RADAR_ETL_UID=1000
RADAR_ETL_GID=1000
