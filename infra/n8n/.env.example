# =============================================================================
# Radar de Expansão — variáveis do n8n (modelo; copie para .env e preencha)
# =============================================================================

# Versão FIXA da imagem (ex.: a última estável no momento da instalação). Nunca "latest".
N8N_VERSAO=

# Gerar uma vez com:  openssl rand -hex 32
# Sem esta chave as credenciais salvas no n8n não podem ser lidas: guarde uma cópia fora do servidor.
N8N_ENCRYPTION_KEY=

# --- Só se o n8n for acessado por um proxy/túnel com domínio próprio (opcional) ---
# N8N_HOST=<n8n.seu-dominio>
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://<n8n.seu-dominio>/
# N8N_PROXY_HOPS=1
