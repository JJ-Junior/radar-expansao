# =============================================================================
# Radar de Expansão — variáveis do Supabase autohospedado (modelo)
# =============================================================================
# Este arquivo lista SÓ as variáveis que o projeto ajusta. Na instalação:
#   1. copie o .env.example OFICIAL da pasta docker/ do Supabase para .env;
#   2. substitua nele os valores abaixo (segredos gerados conforme docs/instalacao.md);
#   3. nunca use os valores de exemplo do arquivo oficial e nunca versione o .env.
# =============================================================================

# --- Segredos (gerar com openssl / gerar_jwt.sh; guardar num gerenciador de senhas) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=

# --- Banco ---
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- API REST: expor apenas o schema gold ---
PGRST_DB_SCHEMAS=gold

# --- Endereços (acesso local pelo túnel SSH; trocar se usar um proxy/túnel com domínio próprio) ---
KONG_HTTP_PORT=8000
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# --- Cadastro de usuários desligado (o projeto não usa login de usuários finais) ---
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=false
ENABLE_PHONE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
