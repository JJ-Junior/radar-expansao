# Radar de Expansao - variaveis do container radar-app (copie para .env e faca chmod 600)
# API REST do Supabase pela rede Docker "radar" (Kong interno, sem passar pela internet)
SUPABASE_URL=http://supabase-kong:8000
# Chave anon (o Kong exige uma chave de consumidor)
SUPABASE_ANON_KEY=
# JWT do papel web_leitor (so SELECT na gold)
SUPABASE_CHAVE_LEITURA=
# Usuario do container (id -u; id -g)
RADAR_APP_UID=1000
RADAR_APP_GID=1000
