# ============================================================
# Radar de Expansão — modelo dos segredos do dashboard (Streamlit)
#
# Local:   copie para .streamlit/secrets.toml (que NUNCA é commitado) ou preencha as
#          mesmas três variáveis no .env da raiz — o app aceita os dois.
#            PowerShell:  Copy-Item .streamlit\secrets.toml.example .streamlit\secrets.toml
# Nuvem:   cole o conteúdo preenchido em Settings > Secrets do app no Streamlit Cloud.
#
# O app lê só a camada gold pela API REST do Supabase (papel somente leitura).
# Sem estes valores, ou se a API não responder, o app usa a cópia da gold em
# site/dados/*.json e avisa na tela de quando são os dados.
# ============================================================

# Endereço da API REST (sem barra no fim e sem /rest/v1)
SUPABASE_URL = "https://<url-da-api>"

# Chave anônima do Supabase: o gateway exige; sozinha não lê nada
SUPABASE_ANON_KEY = ""

# Token (JWT) do papel web_leitor: só leitura nas tabelas da gold
SUPABASE_CHAVE_LEITURA = ""
